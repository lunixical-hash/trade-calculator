# Roblox OAuth credentials (https://create.roblox.com/dashboard/credentials)
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Must match a Redirect URI registered on your Roblox OAuth app
ROBLOX_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Where users return after Sign in with Roblox
PUBLIC_APP_URL=https://lunixical-hash.github.io/trade-calculator/trade_calculator.html

# Auth server bind / public URL
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
AUTH_PUBLIC_URL=http://127.0.0.1:8787

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://lunixical-hash.github.io,null

# Optional: fixed session HMAC secret (random each boot if unset)
# SESSION_SECRET=
